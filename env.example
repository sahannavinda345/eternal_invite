# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The address your site runs on (used to build guest links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel only. Supabase → Project Settings → API → service_role (secret).
# Keeps full access to your database: never share it, never put it in client code,
# and in Vercel add it WITHOUT the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
